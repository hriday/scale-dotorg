# Copy to .env.production on the server and fill in. Never commit the real file.
DATABASE_URL=postgres://booths:CHANGE_ME@db:5432/booths
POSTGRES_PASSWORD=CHANGE_ME

# openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG

PUBLIC_BASE_URL=https://booths.socallinuxexpo.org
MAIL_FROM=dotorgs@socallinuxexpo.org

EMAIL_SENDER=smtp2go
SMTP2GO_API_KEY=CHANGE_ME

# Set true for the very first boot only, to create the settings row,
# the templates and the first admin. Set back to false afterwards.
SEED_ON_START=false
