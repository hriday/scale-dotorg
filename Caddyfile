# Production TLS. Caddy obtains a real certificate from Let's Encrypt on first
# request, which needs the DNS record pointing here and port 80 reachable for
# the ACME challenge.
#
# Mounted by docker-compose.staging.yml once DNS exists; before that,
# Caddyfile.staging serves the bare IP with Caddy's local CA instead.

booths.socallinuxexpo.org {
	encode zstd gzip

	# Uploaded logos are access-checked by the app, so no shared caching.
	header /logo/* Cache-Control "private, max-age=3600"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# A 2 MB logo plus form fields; refuse anything wildly larger at the edge.
	request_body {
		max_size 8MB
	}

	# Caddy runs as a service in the same compose project, so the app is
	# reached by service name, not loopback.
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
